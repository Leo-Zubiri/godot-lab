# --- Secrets / local config (NEVER commit) ---
.env
*.key
*.token
secrets/
# Local Claude Code settings that may hold machine-specific paths/keys
.claude/settings.local.json
.mcp.json

# --- Godot fixture caches (per official Godot .gitignore) ---
fixtures/**/.godot/
fixtures/**/*.translation
# Runtime-generated scripts under test (the wrapper copies the output here per run)
fixtures/godot/scripts/_under_test.gd
fixtures/godot/scripts/*-run-*.gd

# --- Run artifacts: large/raw transcripts are kept locally, not committed ---
# Commit the curated run record (config.yaml, scores.yaml, validation summaries);
# keep bulky raw transcripts out of git. Adjust per experiment if you want them tracked.
runs/**/*.jsonl
runs/**/*.err
runs/**/eval_raw/
runs/**/eval_v2_raw/
runs/**/adversarial/*.json
runs/**/raw/

# --- OS / editor noise ---
.DS_Store
*~
.idea/
.vscode/

# h06 generated artifacts
fixtures/h06/test_report.xml
fixtures/**/.godot/
# Vendored test framework (fetch per fixtures/h06/README.md — pinned, not committed to keep diffs reviewable)
fixtures/**/addons/gut/
# runtime-swapped candidate scripts during the matrix (reference under_test/ IS committed)
fixtures/h06/under_test/_candidate_*.gd
