# godot-lab environment template — COPY to .env (which is gitignored) and fill in locally.
# Never commit real secrets. Reproducibility records store model IDs + settings + SHAs, NOT secrets.

# Path to a READ-ONLY checkout of godot-knowledge used in Condition B (see AGENTS.md).
# Create it as a read-only copy/mount (OS-level), e.g.:  git clone ... && chmod -R a-w
GODOT_KNOWLEDGE_RO_PATH=/abs/path/to/godot-knowledge-readonly

# Pinned Godot binary used for executable validation (Godot 4.7.2-stable, headless-capable).
GODOT_BIN=/abs/path/to/godot-4.7.2-stable

# Generation model: pin a FULL model id (never an alias) — recorded per run.
GEN_MODEL_ID=claude-<pin-exact-id>
GEN_EFFORT=high

# Evaluator model: a DIFFERENT model from the generator; pinned full id — recorded per run.
EVAL_MODEL_ID=claude-<pin-exact-different-id>

# If any provider needs an API key for batch (`claude -p --bare`) runs, put it in .env (gitignored), NOT here.
# ANTHROPIC_API_KEY=
